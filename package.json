{
  "name": "kestrel",
  "productName": "Kestrel",
  "version": "1.0.0",
  "description": "A fast, beautiful AI code editor for macOS \u2014 bring your own keys, Claude Code built in",
  "main": "electron/main.cjs",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test test/*.test.*",
    "postinstall": "node scripts/fix-pty.mjs",
    "demo": "node scripts/demo-workspace.mjs",
    "dist": "vite build && electron-builder --mac --publish never",
    "install-app": "npm run dist && node scripts/install-app.mjs",
    "release": "npm run dist && node scripts/release.mjs",
    "mock-ai": "node scripts/mock-ai.mjs"
  },
  "build": {
    "appId": "local.kestrel.app",
    "productName": "Kestrel",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dir"
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "darkModeSupport": true
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.331",
    "@anthropic-ai/sdk": "^1.13.0",
    "dompurify": "^3.5.0",
    "marked": "^14.1.4",
    "node-pty": "^1.1.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "monaco-editor": "^0.58.0",
    "vite": "^6.4.6"
  }
}
